# B站 AI 运营环境变量配置
# 复制此文件为 .env 并填写

# ========== LLM API ==========
# DeepSeek（性价比最高）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI（可选）
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# ========== B站账号 ==========
# 直播间 ID（数字人直播用）
BILIBILI_ROOM_ID=your-room-id

# ========== 视频生成 ==========
# Edge TTS 音色
TTS_VOICE=zh-CN-XiaoxiaoNeural

# Remotion 渲染配置
RENDER_WIDTH=1920
RENDER_HEIGHT=1080
RENDER_FPS=30

# ========== 内容策略 ==========
# 每日最大操作次数
MAX_COMMENTS_PER_HOUR=30
MAX_DYNAMICS_PER_DAY=10
MAX_UPLOADS_PER_DAY=2

# ========== 安全 ==========
# 私信白名单（逗号分隔的 UID）
DM_WHITELIST=owner

# 敏感词文件路径
WORDLIST_PATH=config/wordlist.txt

# ========== 日志 ==========
LOG_LEVEL=INFO
AUDIT_LOG=audit.log
